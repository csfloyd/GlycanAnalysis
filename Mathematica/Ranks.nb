Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "MakeQ", "]"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MakeQ", "[", 
    RowBox[{"N_", ",", "m_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "allPatterns", ",", "psiSet", ",", "phiSet", ",", "xiList", ",", "Q"}], 
      "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{"all", " ", 
       RowBox[{"2", "^", "N"}], " ", "binary", " ", "vectors", " ", "with", 
       " ", "entries", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "*)"}], 
     RowBox[{
      RowBox[{"allPatterns", "=", 
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "N"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "randomly", " ", "choose", " ", "m", " ", "of", " ", "them", " ", 
        "for", " ", "psi", " ", "and", " ", "phi"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"psiSet", "=", 
       RowBox[{"RandomSample", "[", 
        RowBox[{"allPatterns", ",", "m"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"phiSet", "=", 
       RowBox[{"RandomSample", "[", 
        RowBox[{"allPatterns", ",", "m"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"all", " ", 
        RowBox[{"m", "^", "2"}], " ", "concatenated", " ", "vectors"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"xiList", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"psiSet", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"phiSet", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "m"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "m"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"columns", " ", "are", " ", "xi", " ", "vectors"}], "*)"}], 
      RowBox[{"Q", "=", 
       RowBox[{"Transpose", "[", "xiList", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Q\>\"", "->", "Q"}], ",", 
        RowBox[{"\"\<Dimensions\>\"", "->", 
         RowBox[{"Dimensions", "[", "Q", "]"}]}], ",", 
        RowBox[{"\"\<Rank\>\"", "->", 
         RowBox[{"MatrixRank", "[", "Q", "]"}]}]}], "|>"}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Qout", " ", "=", 
   RowBox[{"MakeQ", "[", 
    RowBox[{"3", ",", "5"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Qout", "[", 
   RowBox[{"[", "\"\<Q\>\"", "]"}], "]"}], "//", 
  "MatrixForm"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Qout", "[", 
   RowBox[{"[", "\"\<Rank\>\"", "]"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{
       RowBox[{"MakeQ", "[", 
        RowBox[{"4", ",", "i"}], "]"}], "[", 
       RowBox[{"[", "\"\<Rank\>\"", "]"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "16"}], "}"}]}], "]"}], "]"}]}], "Input",
