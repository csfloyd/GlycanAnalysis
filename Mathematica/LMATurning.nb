Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", "4"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "Variables", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cVars", "=", 
    RowBox[{"Array", "[", 
     RowBox[{"c", ",", "n"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SeedRandom", "[", "29", "]"}], ";"}], "  ", "\[IndentingNewLine]",
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", "reproducibility", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mVals", "=", 
    RowBox[{"RandomReal", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.1", ",", "100.0"}], "}"}], ",", "n"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kVals", "=", 
    RowBox[{"RandomReal", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.01", ",", "10.0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Parameters", " ", "for", " ", "the", " ", "log"}], "-", 
    RowBox[{"normal", " ", "distribution"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Mu]", "=", "1"}], ";"}], "       ", 
  RowBox[{"(*", 
   RowBox[{
   "Mean", " ", "of", " ", "the", " ", "underlying", " ", "normal", " ", 
    "distribution"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]", "=", "5"}], ";"}], "       ", 
  RowBox[{"(*", 
   RowBox[{"Standard", " ", "deviation"}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Sample", " ", "kVals", " ", "as", " ", "log"}], "-", 
    RowBox[{"normally", " ", "distributed"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"kVals", "=", 
   RowBox[{"RandomVariate", "[", 
    RowBox[{
     RowBox[{"LogNormalDistribution", "[", 
      RowBox[{"\[Mu]", ",", "\[Sigma]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"kVals", " ", "=", " ", 
  RowBox[{"0.5", 
   RowBox[{"(", 
    RowBox[{"kVals", " ", "+", " ", 
     RowBox[{"Transpose", "[", "kVals", "]"}]}], 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kVals", "//", "MatrixForm"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Assign", " ", "random", " ", "positive", " ", "starting", " ", "point", 
    " ", "for", " ", "each", " ", "variable"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"initialGuess", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"cVars", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "->", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"{", 
         RowBox[{"0.1", ",", "2.0"}], "}"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mInd", " ", "=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mRange", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", "1000", ",", "1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solArray", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"soldijArray", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"mVals", "[", 
       RowBox[{"[", "mInd", "]"}], "]"}], "=", "mv"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"eqnsSym", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"cVars", "[", 
             RowBox[{"[", "i", "]"}], "]"}], " ", "*", 
            RowBox[{"cVars", "[", 
             RowBox[{"[", "j", "]"}], "]"}], " ", "*", 
            SuperscriptBox[
             RowBox[{"kVals", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j"}], "]"}], "]"}], 
             RowBox[{"-", "1"}]]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}], "+", 
         RowBox[{"cVars", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "-", 
         RowBox[{"mVals", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sol", "=", 
      RowBox[{"FindRoot", "[", 
       RowBox[{"eqnsSym", ",", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"cVars", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"cVars", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "/.", "initialGuess"}]}], "}"}],
           ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cSol", " ", "=", "  ", 
      RowBox[{"cVars", "/.", "sol"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"solArray", ",", "cSol"}], "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"dij", "=", 
      RowBox[{
       SuperscriptBox["kVals", 
        RowBox[{"-", "1"}]], "*", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"cSol", ",", " ", "cSol"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"upperTriangleList", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"dij", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "i", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"soldijArray", ",", "upperTriangleList"}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"initialGuess", "=", "sol"}], ";"}], "\[IndentingNewLine]", ",", 
    
    RowBox[{"{", 
     RowBox[{"mv", ",", "mRange"}], "}"}]}], "]"}], ";"}], "\n"}], "Input",
