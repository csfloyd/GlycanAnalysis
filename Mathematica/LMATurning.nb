Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"scmFullList", "\[IndentingNewLine]", "scdFullList"}], 
  "*)"}]], "Input",
 CellChangeTimes->{{3.958165232379735*^9, 3.958165232633132*^9}, 
   3.95821658106711*^9},
 CellLabel->"In[90]:=",ExpressionUUID->"bcb97065-b187-403c-8af5-c985afe603ee"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", "3"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "Variables", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cVars", "=", 
    RowBox[{"Array", "[", 
     RowBox[{"c", ",", "n"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"viewIter", " ", "=", " ", "768"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"viewMInd", " ", "=", " ", "1"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mVals", " ", "=", " ", 
   RowBox[{"mValsList", "[", 
    RowBox[{"[", "viewIter", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kVals", " ", "=", " ", 
    RowBox[{"kValsList", "[", 
     RowBox[{"[", "viewIter", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Parameters", " ", "for", " ", "the", " ", "log"}], "-", 
    RowBox[{"normal", " ", "distribution"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Mu]", "=", "1"}], ";"}], "       ", 
  RowBox[{"(*", 
   RowBox[{
   "Mean", " ", "of", " ", "the", " ", "underlying", " ", "normal", " ", 
    "distribution"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]", "=", "5"}], ";"}], "       ", 
  RowBox[{"(*", 
   RowBox[{"Standard", " ", "deviation"}], "*)"}], "\[IndentingNewLine]", 
  "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Assign", " ", "random", " ", "positive", " ", "starting", " ", "point", 
    " ", "for", " ", "each", " ", "variable"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"initialGuess", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"cVars", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "->", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"{", 
         RowBox[{"0.1", ",", "2.0"}], "}"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mInd", " ", "=", " ", "viewMInd"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mRange", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", "500", ",", "0.1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solArray", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"soldijArray", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"mVals", "[", 
       RowBox[{"[", "mInd", "]"}], "]"}], "=", "mv"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"eqnsSym", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"cVars", "[", 
             RowBox[{"[", "i", "]"}], "]"}], " ", "*", 
            RowBox[{"cVars", "[", 
             RowBox[{"[", "j", "]"}], "]"}], " ", "*", 
            SuperscriptBox[
             RowBox[{"kVals", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j"}], "]"}], "]"}], 
             RowBox[{"-", "1"}]]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}], "+", 
         RowBox[{"cVars", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "-", 
         RowBox[{"mVals", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sol", "=", 
      RowBox[{"FindRoot", "[", 
       RowBox[{"eqnsSym", ",", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"cVars", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"cVars", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "/.", "initialGuess"}]}], "}"}],
           ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}], ",", 
        RowBox[{"AccuracyGoal", "->", "10"}], ",", 
        RowBox[{"PrecisionGoal", "->", "10"}], ",", " ", 
        RowBox[{"MaxIterations", "->", "1000"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cSol", " ", "=", "  ", 
      RowBox[{"cVars", "/.", "sol"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"solArray", ",", "cSol"}], "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"dij", "=", 
      RowBox[{
       SuperscriptBox["kVals", 
        RowBox[{"-", "1"}]], "*", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"cSol", ",", " ", "cSol"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"upperTriangleList", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"dij", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "i", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"soldijArray", ",", "upperTriangleList"}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"initialGuess", "=", "sol"}], ";"}], "\[IndentingNewLine]", ",", 
    
    RowBox[{"{", 
     RowBox[{"mv", ",", "mRange"}], "}"}]}], "]"}], ";"}], "\n"}], "Input",
 CellChangeTimes->{{3.9582166049511414`*^9, 3.958216646718833*^9}, {
