     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"JMat", " ", "=", " ", 
   RowBox[{
    RowBox[{"DiagonalMatrix", "[", "diagTerm", "]"}], "+", "offDiagTerm"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"JInv", " ", "=", " ", 
   RowBox[{"Inverse", "[", "JMat", "]"}]}], ";"}]}], "Input",
