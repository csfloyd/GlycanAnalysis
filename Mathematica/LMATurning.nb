Cell[BoxData[{
 RowBox[{
  RowBox[{"nd", " ", "=", " ", "4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Qf", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"CC", "[", "i", "]"}], "*", 
      RowBox[{"KK", "[", 
       RowBox[{"i", ",", "j"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "nd"}], "}"}], ",", 
     RowBox[{"{", 
