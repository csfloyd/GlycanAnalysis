Cell[BoxData[
 RowBox[{
  RowBox[{"makeEquationSystemRHS", "[", "g_Graph", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"nodes", ",", "eqns"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nodes", "=", 
      RowBox[{"VertexList", "[", "g", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eqns", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"parents", ",", "num", ",", "den"}], "}"}], ",", 
          RowBox[{
           RowBox[{"parents", "=", 
            RowBox[{"VertexInComponent", "[", 
             RowBox[{"g", ",", "i", ",", 
              RowBox[{"{", "1", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           
           RowBox[{"(*", 
            RowBox[{"incoming", " ", "neighbors"}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"num", "=", 
            RowBox[{
             RowBox[{"kf", "[", "i", "]"}], "+", 
             RowBox[{"Total", "[", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"kf", "[", 
                  RowBox[{"i", ",", "p"}], "]"}], " ", 
                 RowBox[{"L", "[", "p", "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"p", ",", "parents"}], "}"}]}], "]"}], "]"}]}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"den", "=", 
            RowBox[{
             RowBox[{"kt", "[", "i", "]"}], "+", 
             RowBox[{"Total", "[", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"kt", "[", 
                  RowBox[{"i", ",", "p"}], "]"}], " ", 
                 RowBox[{"L", "[", "p", "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"p", ",", "parents"}], "}"}]}], "]"}], "]"}]}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"LT", "[", "i", "]"}], "*", 
             RowBox[{"num", "/", "den"}]}], "-", 
            RowBox[{"L", "[", "i", "]"}]}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "nodes"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "eqns"}]}], "]"}]}]], "Input",
