       RowBox[{"Original", " ", "forward"}], "-", 
       RowBox[{"only", " ", "DAG", " ", "construction"}]}], "*)"}], 
     RowBox[{
      RowBox[{"elems", "=", 
       RowBox[{"RandomSample", "@", 
        RowBox[{"PadRight", "[", 
         RowBox[{
          RowBox[{"ConstantArray", "[", 
           RowBox[{"1", ",", "edgeCount"}], "]"}], ",", 
          RowBox[{"vertexCount", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"vertexCount", "-", "1"}], ")"}], "/", "2"}]}]}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"adjacencyMatrix", "=", 
       RowBox[{
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{"FoldList", "[", 
           RowBox[{"RotateLeft", ",", "elems", ",", 
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", 
              RowBox[{"vertexCount", "-", "2"}]}], "]"}]}], "]"}], ",", "All",
           ",", "vertexCount"}], "]"}], "~", "LowerTriangularize", "~", 
        RowBox[{"-", "1"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"adjacencyMatrix", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "1"}], "]"}], "]"}], "=", "1"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"adjacencyMatrix", "=", 
       RowBox[{"Transpose", "[", "adjacencyMatrix", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Add", " ", "random", " ", "backward", " ", "connections", " ", "with",
         " ", "probability", " ", "p"}], "*)"}], 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"p", ">", "0"}], ",", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "<=", "vertexCount"}], ",", 
          RowBox[{"i", "++"}], ",", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"j", "=", 
             RowBox[{"i", "+", "1"}]}], ",", 
            RowBox[{"j", "<=", "vertexCount"}], ",", 
            RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Only", " ", "add", " ", "backward", " ", "edge", " ", "if", " ", 
              RowBox[{"there", "'"}], "s", " ", "no", " ", "forward", " ", 
              "edge", " ", "and", " ", "random", " ", "test", " ", "passes"}],
              "*)"}], "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
