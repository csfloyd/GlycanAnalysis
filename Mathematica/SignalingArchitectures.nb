Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "parameter", " ", "symbols"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"kParams", "=", 
     RowBox[{"{", 
      RowBox[{
      "ktX", ",", "kfX", ",", "ktXR", ",", "kfXR", ",", "ktXS", ",", "kfXS", 
       ",", "ktY", ",", "kfY", ",", "ktYX", ",", "kfYX", ",", "ktZ", ",", 
       "kfZ", ",", "ktZR", ",", "kfZR", ",", "ktZS", ",", "kfZS", ",", "ktS", 
       ",", "kfS", ",", "ktSX", ",", "kfSX", ",", "ktSY", ",", "kfSY", ",", 
       "ktSZ", ",", "kfSZ"}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"l0Params", "=", 
     RowBox[{"{", 
      RowBox[{"lR0", ",", "lX0", ",", "lY0", ",", "lZ0", ",", "lS0"}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Assign", " ", "random", " ", "values", " ", "satisfying", " ", 
      RowBox[{"k", "^", "t"}]}], ">", 
     RowBox[{"k", "^", "f"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"kf", "=", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"{", 
               RowBox[{"0.1", ",", "50"}], "}"}], "]"}]}], ",", "kt"}], "}"}],
           ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"kt", "=", 
            RowBox[{"kf", "+", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"{", 
               RowBox[{"0.1", ",", "50"}], "}"}], "]"}]}]}], ";", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"ensure", " ", "kt"}], ">", "kf"}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Symbol", "[", 
               RowBox[{"StringReplace", "[", 
                RowBox[{
                 RowBox[{"ToString", "[", "param", "]"}], ",", 
                 RowBox[{"\"\<f\>\"", "->", "\"\<t\>\""}]}], "]"}], "]"}], "->",
               "kt"}], ",", 
             RowBox[{"param", "->", "kf"}]}], "}"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"param", ",", 
          RowBox[{"Select", "[", 
           RowBox[{"kParams", ",", 
            RowBox[{
             RowBox[{"StringContainsQ", "[", 
              RowBox[{
               RowBox[{"ToString", "[", "#", "]"}], ",", "\"\<f\>\""}], "]"}],
              "&"}]}], "]"}]}], "}"}]}], "]"}], "//", "Flatten"}], "//", 
     "Evaluate"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"kAssignments", "=", "%"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Assign", " ", "random", " ", "positive", " ", "l0s"}], ",", 
     RowBox[{"leaving", " ", "lR0", " ", "unassigned"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"l0Assignments", "=", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"lX0", ",", "lY0", ",", "lZ0", ",", "lS0"}], "}"}], "->", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0.1", ",", "2"}], "}"}], ",", "4"}], "]"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Combine", " ", "all", " ", "assignments", " ", 
     RowBox[{"(", 
      RowBox[{"except", " ", "lR0"}], ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"paramAssignments", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"kAssignments", ",", "l0Assignments"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n"}]}]], "Input",
