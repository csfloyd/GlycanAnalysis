Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"initialGuesses", "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"X", ",", "Y", ",", "Z", ",", "S"}], "}"}], "/.", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"X", ",", "Y", ",", "Z", ",", "S"}], "}"}], "->", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0.1", ",", "1.5"}], "}"}], ",", "4"}], "]"}]}], "]"}]}]}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Use", " ", "FindRoot", " ", "to", " ", "get", " ", "one", " ", "steady", 
    " ", "state"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lR0eval", " ", "=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lR0Range", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", "4", ",", ".01"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nullVals", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solVals", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solLength", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"sol", "=", 
       RowBox[{"Quiet", "@", 
        RowBox[{"FindRoot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"eqs", "/.", " ", "paramAssignments"}], "/.", 
           RowBox[{"lR0", "->", "lR0eval"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"X", ",", 
            RowBox[{"initialGuesses", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"Y", ",", 
            RowBox[{"initialGuesses", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"Z", ",", 
            RowBox[{"initialGuesses", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"S", ",", 
            RowBox[{"initialGuesses", "[", 
             RowBox[{"[", "4", "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"MaxIterations", "->", "200"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"solVals", ",", 
        RowBox[{"{", 
         RowBox[{"lR0eval", ",", 
          RowBox[{"S", "/.", "sol"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"exprEval", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"expr", "/.", " ", "paramAssignments"}], "/.", 
         RowBox[{"lR0", "->", "lR0eval"}]}], "/.", 
        RowBox[{"sol", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", "3"}], "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"solDeriv", "=", 
       RowBox[{"Quiet", "@", 
        RowBox[{"FindRoot", "[", 
         RowBox[{"exprEval", ",", 
          RowBox[{"{", 
           RowBox[{"S", ",", 
            RowBox[{"initialGuesses", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"AccuracyGoal", "->", "10"}], ",", "\[IndentingNewLine]", 
          RowBox[{"PrecisionGoal", "->", "10"}], ",", "\[IndentingNewLine]", 
          RowBox[{"MaxIterations", "->", "200000"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"nullVals", ",", 
        RowBox[{"{", 
         RowBox[{"lR0eval", ",", 
          RowBox[{"S", "/.", "solDeriv"}]}], "}"}]}], "]"}], ";"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"exprEval", "=", 
        RowBox[{
         RowBox[{"expr", "/.", " ", "paramAssignments"}], "/.", "sol"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"solDeriv", "=", 
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{"exprEval", "==", "0"}], ",", 
          RowBox[{"{", "lR0", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"solLength", ",", " ", 
         RowBox[{"Length", "[", "solDeriv", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"nullVals", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"lR0", "/.", "solDeriv"}], ")"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"S", "/.", "sol"}]}], "}"}]}], "]"}], ";"}], "*)"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
     RowBox[{"{", 
      RowBox[{"lR0eval", ",", "lR0Range"}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
