             RowBox[{
              RowBox[{"LVars", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"LT", "[", "i", "]"}], "/.", "ltRules"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "2", ",", "nNodes"}], "}"}]}], "]"}], ",", 
          RowBox[{"AccuracyGoal", "->", "10"}], ",", 
          RowBox[{"PrecisionGoal", "->", "10"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"m", ",", "1", ",", 
         RowBox[{"Length", "[", "L1Array", "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"solFunc", ":=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{"Transpose", "[", 
