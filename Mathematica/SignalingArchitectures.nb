Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"kfktRules", "=", 
   RowBox[{"RandomKFKTParams", "[", 
    RowBox[{"graph", ",", "1", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ltRules", "=", 
   RowBox[{"RandomLTParams", "[", 
    RowBox[{"graph", ",", "1", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "4"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"allRules", "=", 
    RowBox[{"Join", "[", 
     RowBox[{"kfktRules", ",", "ltRules"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rhs", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"makeEquationSystemRHS", "[", "graph", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ";;"}], "]"}], "]"}], "/.", "allRules"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lower", " ", "=", " ", 
   SuperscriptBox["10", 
    RowBox[{"-", "3"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"upper", " ", "=", " ", 
   SuperscriptBox["10", "4"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"L1Array", " ", "=", " ", 
    RowBox[{"PowerRange", "[", 
     RowBox[{"lower", ",", "upper", ",", "1.1"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"LVars", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"L", "[", "i", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "nNodes"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"sols", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"LVars", "[", 
         RowBox[{"[", 
          RowBox[{"2", ";;"}], "]"}], "]"}], "/.", 
        RowBox[{"FindRoot", "[", 
         RowBox[{
          RowBox[{"rhs", "/.", 
           RowBox[{
            RowBox[{"L", "[", "1", "]"}], "->", 
            RowBox[{"L1Array", "[", 
             RowBox[{"[", "m", "]"}], "]"}]}]}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"LVars", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"LT", "[", "i", "]"}], "/.", "ltRules"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "2", ",", "nNodes"}], "}"}]}], "]"}], ",", 
          RowBox[{"AccuracyGoal", "->", "10"}], ",", 
          RowBox[{"PrecisionGoal", "->", "10"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"m", ",", "1", ",", 
         RowBox[{"Length", "[", "L1Array", "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"solFunc", ":=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"L1Array", ",", 
         RowBox[{"sols", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", 
            RowBox[{"nNodes", "-", "1"}]}], "]"}], "]"}]}], "}"}], "]"}], 
      "]"}]}]}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"solFuncc", "[", "r_", "]"}], ":=", 
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"expr", "/.", "allRules"}], "/.", 
     RowBox[{
      RowBox[{"L", "[", "1", "]"}], "->", "r"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gradFunc", " ", "=", " ", 
   RowBox[{"solFuncc", "'"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"LogLinearPlot", "[", 
  RowBox[{
   RowBox[{"solFuncc", "[", "r", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"r", ",", "lower", ",", "upper"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "Full"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"LogLinearPlot", "[", 
  RowBox[{
   RowBox[{"gradFunc", "[", "r", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"r", ",", "lower", ",", "upper"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "Full"}]}], "]"}]}], "Input",
