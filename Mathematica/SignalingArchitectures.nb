       RowBox[{"idx", "[", 
        RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
       RowBox[{
        RowBox[{"cumCounts", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "+", "j"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"edges", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"DirectedEdge", "[", 
           RowBox[{
            RowBox[{"idx", "[", 
             RowBox[{"i", ",", "j"}], "]"}], ",", 
            RowBox[{"idx", "[", 
             RowBox[{
              RowBox[{"i", "+", "1"}], ",", "k"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"layers", "-", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"nodesPerLayer", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"nodesPerLayer", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "}"}]}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Calculate", " ", "y"}], "-", 
