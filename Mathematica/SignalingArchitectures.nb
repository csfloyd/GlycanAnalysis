             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"Length", "[", 
                RowBox[{"yCoords", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "layers"}], "}"}]}], "]"}], ",", "1"}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Create", " ", "the", " ", "graph"}], "*)"}], 
      RowBox[{"graph", "=", 
       RowBox[{"Graph", "[", 
        RowBox[{"nodes", ",", "edges", ",", 
         RowBox[{"VertexStyle", "->", "Black"}], ",", 
         RowBox[{"EdgeStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"Black", ",", 
            RowBox[{"Thickness", "[", "0.005", "]"}]}], "]"}]}], ",", 
         RowBox[{"VertexCoordinates", "->", 
          RowBox[{"AssociationThread", "[", 
           RowBox[{"nodes", "->", "nodePos"}], "]"}]}], ",", 
         RowBox[{"VertexSize", "->", "0.15"}], ",", 
         RowBox[{"ImageSize", "->", "160"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "graph"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
