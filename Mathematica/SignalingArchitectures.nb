               RowBox[{
                RowBox[{"adjacencyMatrix", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "j"}], "]"}], "]"}], "==", "0"}], "&&"}], 
              "*)"}], 
             RowBox[{
              RowBox[{
               RowBox[{"RandomReal", "[", "]"}], "<", "p"}], ",", 
              RowBox[{
