        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"idx", "[", 
        RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
       RowBox[{
        RowBox[{"cumCounts", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "+", "j"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"edges", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"DirectedEdge", "[", 
           RowBox[{
            RowBox[{"idx", "[", 
             RowBox[{"i", ",", "j"}], "]"}], ",", 
            RowBox[{"idx", "[", 
             RowBox[{
              RowBox[{"i", "+", "1"}], ",", "k"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"layers", "-", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"nodesPerLayer", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"nodesPerLayer", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "}"}]}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Calculate", " ", "y"}], "-", 
        RowBox[{
        "coordinates", " ", "to", " ", "center", " ", "nodes", " ", "in", " ",
          "each", " ", "layer"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"yCoords", "=", 
       RowBox[{"0.75", "*", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"nodesPerLayer", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "-", "1"}], ")"}]}], "/", 
             "2"}], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"nodesPerLayer", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "-", "1"}], ")"}], "/", 
             "2"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "layers"}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Combine", " ", "x", " ", "and", " ", "y", " ", "coordinates", " ", 
        "for", " ", "node", " ", "positions"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"nodePos", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"0.5", "*", "i"}], ",", 
               RowBox[{"yCoords", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"Length", "[", 
                RowBox[{"yCoords", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "layers"}], "}"}]}], "]"}], ",", "1"}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Create", " ", "the", " ", "graph"}], "*)"}], 
      RowBox[{"graph", "=", 
       RowBox[{"Graph", "[", 
        RowBox[{"nodes", ",", "edges", ",", 
         RowBox[{"VertexStyle", "->", "Black"}], ",", 
         RowBox[{"EdgeStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"Black", ",", 
            RowBox[{"Thickness", "[", "0.005", "]"}]}], "]"}]}], ",", 
         RowBox[{"VertexCoordinates", "->", 
          RowBox[{"AssociationThread", "[", 
           RowBox[{"nodes", "->", "nodePos"}], "]"}]}], ",", 
         RowBox[{"VertexSize", "->", "0.15"}], ",", 
         RowBox[{"ImageSize", "->", "160"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "graph"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
