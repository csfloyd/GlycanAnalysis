  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rhs", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"makeEquationSystemRHS", "[", "graph", "]"}], "[", 
      RowBox[{"[", 
