    RowBox[{"lower", " ", "=", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "3"}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"upper", " ", "=", " ", 
     SuperscriptBox["10", "3"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nPoints", " ", "=", " ", "200"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"L1Array", " ", "=", " ", 
     RowBox[{"PowerRange", "[", 
      RowBox[{"lower", ",", "upper", ",", "1.1"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"samplePts", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"10", "^", "r"}], ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", 
          RowBox[{"Log10", "[", 
           RowBox[{"1.01", "lower"}], "]"}], ",", 
          RowBox[{"Log10", "[", 
           RowBox[{"0.99", "upper"}], "]"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Log10", "[", "upper", "]"}], "-", 
             RowBox[{"Log10", "[", "lower", "]"}]}], ")"}], "/", 
           "nPoints"}]}], "}"}]}], "]"}], "//", "N"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"signChangesList", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"kfktRules", "=", 
        RowBox[{"RandomKFKTParams", "[", 
         RowBox[{"graph", ",", "1", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "4"}], ",", "4"}], "}"}]}], "]"}]}], ";", "\n", 
       "     ", 
       RowBox[{"ltRules", "=", 
        RowBox[{"RandomLTParams", "[", 
         RowBox[{"graph", ",", "1", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "4"}], ",", "4"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"allRules", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"kfktRules", ",", "ltRules"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"rhs", " ", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"makeEquationSystemRHS", "[", "graph", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"2", ";;"}], "]"}], "]"}], "/.", "allRules"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"LVars", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"L", "[", "i", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "nNodes"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"sols", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"LVars", "[", 
              RowBox[{"[", 
               RowBox[{"2", ";;"}], "]"}], "]"}], "/.", 
             RowBox[{"FindRoot", "[", 
              RowBox[{
               RowBox[{"rhs", "/.", 
                RowBox[{
                 RowBox[{"L", "[", "1", "]"}], "->", 
                 RowBox[{"L1Array", "[", 
                  RowBox[{"[", "m", "]"}], "]"}]}]}], ",", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"LVars", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                   RowBox[{
                    RowBox[{"LT", "[", "i", "]"}], "/.", "ltRules"}]}], "}"}],
                  ",", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "2", ",", "nNodes"}], "}"}]}], "]"}], ",", 
               RowBox[{"AccuracyGoal", "->", "10"}], ",", 
               RowBox[{"PrecisionGoal", "->", "10"}], ",", 
               RowBox[{"MaxIterations", "->", "5000"}], ",", 
               RowBox[{"Method", "->", 
                RowBox[{"{", 
                 RowBox[{"\"\<Newton\>\"", ",", " ", 
                  RowBox[{
                  "\"\<StepControl\>\"", " ", "->", " ", 
                   "\"\<TrustRegion\>\""}]}], "}"}]}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", "1", ",", 
              RowBox[{"Length", "[", "L1Array", "]"}]}], "}"}]}], "]"}]}], 
         ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"solFunc", ":=", 
          RowBox[{"Interpolation", "[", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{"L1Array", ",", 
              RowBox[{"sols", "[", 
               RowBox[{"[", 
                RowBox[{";;", ",", 
                 RowBox[{"nNodes", "-", "1"}]}], "]"}], "]"}]}], "}"}], "]"}],
            "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"gradFunc", " ", "=", " ", 
          RowBox[{"solFunc", "'"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       "\n", "     ", 
       RowBox[{
        RowBox[{"solFuncc", "[", "r_", "]"}], ":=", 
        RowBox[{"Evaluate", "[", 
         RowBox[{
          RowBox[{"expr", "/.", "allRules"}], "/.", 
          RowBox[{
           RowBox[{"L", "[", "1", "]"}], "->", "r"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"gradFunc", "=", 
        RowBox[{"solFuncc", "'"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"signChanges", "=", 
        RowBox[{
         RowBox[{"Partition", "[", 
          RowBox[{"samplePts", ",", "2", ",", "1"}], "]"}], "/.", " ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a_", ",", "b_"}], "}"}], ":>", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Sign", "[", 
              RowBox[{"gradFunc", "[", "a", "]"}], "]"}], "!=", 
             RowBox[{"Sign", "[", 
              RowBox[{"gradFunc", "[", "b", "]"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"a", ",", "b"}], "}"}], ",", "Nothing"}], "]"}]}]}]}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"signChangesList", ",", 
         RowBox[{"Length", "[", "signChanges", "]"}]}], "]"}], ";"}], 
      "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"nIter", ",", "1", ",", "10000"}], "}"}]}], 
     "\[IndentingNewLine]", "]"}], "//", "AbsoluteTiming"}]}]}]], "Input",
