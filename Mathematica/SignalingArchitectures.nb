              RowBox[{
               RowBox[{
                RowBox[{"adjacencyMatrix", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "j"}], "]"}], "]"}], "==", "0"}], "&&"}], 
              "*)"}], 
             RowBox[{
              RowBox[{
               RowBox[{"RandomReal", "[", "]"}], "<", "p"}], ",", 
              RowBox[{
               RowBox[{"adjacencyMatrix", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", "i"}], "]"}], "]"}], "=", "1"}]}], "]"}]}],
            "]"}]}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
