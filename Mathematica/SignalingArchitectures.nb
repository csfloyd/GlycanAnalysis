 RowBox[{
  RowBox[{
   RowBox[{"RandomDirectedGraphAdjacency", "[", 
    RowBox[{"vertexCount_", ",", "edgeCount_", ",", 
     RowBox[{"p_", ":", "0"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "elems", ",", "adjacencyMatrix", ",", "graph", ",", 
