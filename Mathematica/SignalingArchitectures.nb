        "coordinates", " ", "to", " ", "center", " ", "nodes", " ", "in", " ",
          "each", " ", "layer"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"yCoords", "=", 
       RowBox[{"0.75", "*", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"nodesPerLayer", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "-", "1"}], ")"}]}], "/", 
             "2"}], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"nodesPerLayer", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "-", "1"}], ")"}], "/", 
             "2"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "layers"}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Combine", " ", "x", " ", "and", " ", "y", " ", "coordinates", " ", 
        "for", " ", "node", " ", "positions"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"nodePos", "=", 
       RowBox[{"Flatten", "[", 
