Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<HierarchicalClustering`\>\"", "]"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"matrixLog", "=", "dat"}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Cluster", " ", "rows", " ", "and", " ", "columns"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rowCluster", "=", 
    RowBox[{"Agglomerate", "[", 
     RowBox[{
      RowBox[{"matrixLog", "->", "tcrLabels"}], ",", 
      RowBox[{"Linkage", "->", "\"\<Ward\>\""}], ",", 
      RowBox[{"DistanceFunction", "->", "SquaredEuclideanDistance"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"colCluster", "=", 
    RowBox[{"Agglomerate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Transpose", "[", "matrixLog", "]"}], "->", "epitopeLabels"}], 
      ",", 
      RowBox[{"Linkage", "->", "\"\<Ward\>\""}], ",", 
      RowBox[{"DistanceFunction", "->", "SquaredEuclideanDistance"}]}], 
     "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Extract", " ", "sorted", " ", "labels", " ", "directly", " ", "from", " ",
     "cluster", " ", "leaf", " ", "order"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tcrOrdered", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"rowCluster", "/.", " ", 
     RowBox[{
      RowBox[{"Cluster", "[", 
       RowBox[{"d_", ",", "__"}], "]"}], ":>", "d"}]}], "]"}]}], ";"}], "\n", 

 RowBox[{
  RowBox[{
   RowBox[{"epitopeOrdered", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{"colCluster", "/.", " ", 
      RowBox[{
       RowBox[{"Cluster", "[", 
        RowBox[{"d_", ",", "__"}], "]"}], ":>", "d"}]}], "]"}]}], ";"}], "\n",
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Get", " ", "index", " ", "order"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rowOrder", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Position", "[", 
       RowBox[{"tcrLabels", ",", "#"}], "]"}], "&"}], "/@", "tcrOrdered"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"colOrder", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{"epitopeLabels", ",", "#"}], "]"}], "&"}], "/@", 
      "epitopeOrdered"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Reorder", " ", "and", " ", "plot"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"MatrixPlot", "[", 
  RowBox[{
   RowBox[{"matrixLog", "[", 
    RowBox[{"[", 
     RowBox[{"rowOrder", ",", "colOrder"}], "]"}], "]"}], ",", 
   RowBox[{"ColorFunction", "->", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Blend", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RGBColor", "[", 
           RowBox[{"0.08", ",", "0.38", ",", "0.75"}], "]"}], ",", "White"}], 
         "}"}], ",", "#"}], "]"}], "&"}], ")"}]}], ",", 
   RowBox[{"ColorFunctionScaling", "->", "True"}], ",", 
   RowBox[{"FrameTicks", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"tcrOrdered", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", "8", ",", 
              RowBox[{"FontFamily", "->", "\"\<Courier\>\""}]}], "]"}]}], 
           "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "tcrOrdered", "]"}]}], "}"}]}], "]"}], ",",
         "None"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
