      RowBox[{"(", 
       RowBox[{"epitope", " ", "sequences"}], ")"}]}], ",", 
     RowBox[{"first", " ", "column", " ", "is", " ", "TCR", " ", "names"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"epitopeLabels", "=", 
