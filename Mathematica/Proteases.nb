Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Clear", "*)"}], 
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\n", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Adjustable"}]}], " ", "parameter", " ", 
      RowBox[{"ranges", "--"}]}], "-"}], "*)"}], 
   RowBox[{
    RowBox[{"paramRanges", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<\[Alpha]\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.5", ",", "2"}], "}"}]}], ",", 
       RowBox[{"\"\<\[Gamma]\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.5", ",", "2"}], "}"}]}], ",", 
       RowBox[{"\"\<\[Gamma]*\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.5", ",", "2"}], "}"}]}], ",", 
       RowBox[{"\"\<k\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.5", ",", "2"}], "}"}]}]}], "|>"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Sample"}]}], " ", 
      RowBox[{"parameters", "--"}]}], "-"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"seed", " ", "=", " ", 
     RowBox[{"RandomInteger", "[", "1000", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"seed", " ", "=", " ", "980"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "seed", "]"}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"params", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<\[Alpha]i\>\"", "->", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"paramRanges", "[", "\"\<\[Alpha]\>\"", "]"}], "]"}]}], ",", 
       
       RowBox[{"\"\<\[Alpha]j\>\"", "->", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"paramRanges", "[", "\"\<\[Alpha]\>\"", "]"}], "]"}]}], ",", 
       
       RowBox[{"\"\<\[Alpha]k\>\"", "->", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"paramRanges", "[", "\"\<\[Alpha]\>\"", "]"}], "]"}]}], ",", 
       
       RowBox[{"\"\<\[Gamma]i\>\"", "->", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"paramRanges", "[", "\"\<\[Gamma]\>\"", "]"}], "]"}]}], ",", 
       
       RowBox[{"\"\<\[Gamma]j\>\"", "->", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"paramRanges", "[", "\"\<\[Gamma]\>\"", "]"}], "]"}]}], ",", 
       
       RowBox[{"\"\<\[Gamma]k\>\"", "->", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"paramRanges", "[", "\"\<\[Gamma]\>\"", "]"}], "]"}]}], ",", 
       
       RowBox[{"\"\<\[Gamma]i*\>\"", "->", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"paramRanges", "[", "\"\<\[Gamma]*\>\"", "]"}], "]"}]}], ",", 
       RowBox[{"\"\<\[Gamma]j*\>\"", "->", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"paramRanges", "[", "\"\<\[Gamma]*\>\"", "]"}], "]"}]}], ",", 
       RowBox[{"\"\<\[Gamma]k*\>\"", "->", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"paramRanges", "[", "\"\<\[Gamma]*\>\"", "]"}], "]"}]}], ",", 
       RowBox[{"\"\<kij\>\"", "->", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"paramRanges", "[", "\"\<k\>\"", "]"}], "]"}]}], ",", 
       RowBox[{"\"\<kik\>\"", "->", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"paramRanges", "[", "\"\<k\>\"", "]"}], "]"}]}], ",", 
       RowBox[{"\"\<kju\>\"", "->", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"paramRanges", "[", "\"\<k\>\"", "]"}], "]"}]}], ",", 
       RowBox[{"\"\<kku\>\"", "->", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"paramRanges", "[", "\"\<k\>\"", "]"}], "]"}]}]}], "|>"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"--", 
     RowBox[{"-", 
      RowBox[{"Helper", ":", 
       RowBox[{
        RowBox[{"p", 
         RowBox[{"(", "F", ")"}], " ", "from", " ", 
         RowBox[{"quadratic", "--"}]}], "-"}]}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pSolve", "[", 
     RowBox[{"F_", ",", "\[Alpha]_", ",", "\[Gamma]_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Alpha]", "-", "\[Gamma]", "-", "F", "+", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Gamma]", "+", "F", "-", "\[Alpha]"}], ")"}], "^", "2"}],
          "+", 
         RowBox[{"4", " ", "\[Gamma]", " ", "\[Alpha]"}]}], "]"}]}], ")"}], 
     "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", "\[Gamma]"}], ")"}]}]}], "\n", "\[IndentingNewLine]", 
   
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Total"}]}], " ", "T", " ", "from", " ", 
      RowBox[{"p", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"TSolve", "[", 
     RowBox[{"p_", ",", "\[Alpha]_", ",", "\[Gamma]_", ",", "\[Gamma]s_"}], 
     "]"}], ":=", 
    RowBox[{
     RowBox[{"\[Alpha]", "/", "\[Gamma]s"}], "+", 
     RowBox[{"p", " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"\[Gamma]", "/", "\[Gamma]s"}]}], ")"}]}]}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Compute"}]}], " ", "p_i", 
      RowBox[{
       RowBox[{"(", "Tu", ")"}], "--"}]}], "-"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"piOfTu", "[", 
     RowBox[{"Tu_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Alpha]i", "=", 
         RowBox[{"params", "[", "\"\<\[Alpha]i\>\"", "]"}]}], ",", 
        RowBox[{"\[Alpha]j", "=", 
         RowBox[{"params", "[", "\"\<\[Alpha]j\>\"", "]"}]}], ",", 
        RowBox[{"\[Alpha]k", "=", 
         RowBox[{"params", "[", "\"\<\[Alpha]k\>\"", "]"}]}], ",", 
        RowBox[{"\[Gamma]i", "=", 
         RowBox[{"params", "[", "\"\<\[Gamma]i\>\"", "]"}]}], ",", 
        RowBox[{"\[Gamma]j", "=", 
         RowBox[{"params", "[", "\"\<\[Gamma]j\>\"", "]"}]}], ",", 
        RowBox[{"\[Gamma]k", "=", 
         RowBox[{"params", "[", "\"\<\[Gamma]k\>\"", "]"}]}], ",", 
        RowBox[{"\[Gamma]is", "=", 
         RowBox[{"params", "[", "\"\<\[Gamma]i*\>\"", "]"}]}], ",", 
        RowBox[{"\[Gamma]js", "=", 
         RowBox[{"params", "[", "\"\<\[Gamma]j*\>\"", "]"}]}], ",", 
        RowBox[{"\[Gamma]ks", "=", 
         RowBox[{"params", "[", "\"\<\[Gamma]k*\>\"", "]"}]}], ",", 
        RowBox[{"kij", "=", 
         RowBox[{"params", "[", "\"\<kij\>\"", "]"}]}], ",", 
        RowBox[{"kik", "=", 
         RowBox[{"params", "[", "\"\<kik\>\"", "]"}]}], ",", 
        RowBox[{"kju", "=", 
         RowBox[{"params", "[", "\"\<kju\>\"", "]"}]}], ",", 
        RowBox[{"kku", "=", 
         RowBox[{"params", "[", "\"\<kku\>\"", "]"}]}], ",", "pj", ",", "pk", 
        ",", "Tj", ",", "Tk", ",", "Fi", ",", "pi"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"upstream", " ", "nodes", " ", "j"}], ",", "k"}], "*)"}], 
      RowBox[{
       RowBox[{"pj", "=", 
        RowBox[{"pSolve", "[", 
         RowBox[{
          RowBox[{"kju", " ", "Tu"}], ",", "\[Alpha]j", ",", "\[Gamma]j"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"pk", "=", 
        RowBox[{"pSolve", "[", 
         RowBox[{
          RowBox[{"kku", " ", "Tu"}], ",", "\[Alpha]k", ",", "\[Gamma]k"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Tj", "=", 
        RowBox[{"TSolve", "[", 
         RowBox[{
         "pj", ",", "\[Alpha]j", ",", "\[Gamma]j", ",", "\[Gamma]js"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Tk", "=", 
        RowBox[{"TSolve", "[", 
         RowBox[{
         "pk", ",", "\[Alpha]k", ",", "\[Gamma]k", ",", "\[Gamma]ks"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"downstream", " ", "i"}], "*)"}], 
       RowBox[{"Fi", "=", 
        RowBox[{
         RowBox[{"kij", " ", "Tj"}], "+", 
         RowBox[{"kik", " ", "Tk"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"pi", "=", 
        RowBox[{"pSolve", "[", 
         RowBox[{"Fi", ",", "\[Alpha]i", ",", "\[Gamma]i"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "pi"}]}], "]"}]}], "\[IndentingNewLine]", "\n", 
   
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", 
       RowBox[{"Plot", "--"}]}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fontsize", " ", "=", " ", "20"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fontsizePlot", "=", "24"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SetOptions", "[", 
     RowBox[{"Plot", ",", "\[IndentingNewLine]", 
      RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Axes", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
