      "\[IndentingNewLine]", 
      RowBox[{"FrameTicksStyle", "->", 
       RowBox[{"Thickness", "[", ".003", "]"}]}], ",", "\[IndentingNewLine]", 
      
      RowBox[{"Method", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<AxesInFront\>\"", "->", "False"}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"FrameStyle", "\[Rule]", 
       RowBox[{"Directive", "[", 
        RowBox[{
         RowBox[{"Thickness", "[", "0.003", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}], ",", "Black", 
           ",", 
           RowBox[{"FontSize", "\[Rule]", 
            RowBox[{"fontsizePlot", "-", "4"}]}]}], "}"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"LabelStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}], ",", "Black", 
         ",", 
         RowBox[{"FontSize", "\[Rule]", "fontsizePlot"}]}], "}"}]}]}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"piOfTu", "[", "Tu", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"Tu", ",", "0", ",", "5"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<\!\(\*SubscriptBox[\(T\), \(u\)]\)\>\"", ",", 
        "\"\<\!\(\*SubscriptBox[\(p\), \(i\)]\)\>\""}], "}"}]}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", "Thick"}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}]}]], "Input",
