Notebook[{

Cell[CellGroupData[{
Cell["Simple control problem", "Subsubsection",
 CellChangeTimes->{{3.958568999399328*^9, 3.958569001272253*^9}, {
  3.958644997467268*^9, 
  3.958645000546768*^9}},ExpressionUUID->"8a89957c-60fb-8040-9c97-\
bc9270d5a9f3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Time", " ", "domain", " ", "and", " ", "target"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T", "=", "3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"x0", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"xStar", "[", "t_", "]"}], ":=", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "3"}], "t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "*)"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Training", " ", "hyperparameters"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Eta]max", "=", "0.5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"c", "=", "0.5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Beta]", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nIter", "=", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Theta]", "=", 
    RowBox[{"-", "5"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"initial", " ", "guess"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Theta]Hist", "=", 
   RowBox[{"{", "\[Theta]", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lossHist", "=", 
    RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "compute", " ", "loss", " ", "and", " ", 
    "gradient", " ", "for", " ", "given", " ", "\[Theta]"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"computeLossAndGrad", "[", "\[Theta]_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xSol", ",", "\[Lambda]Sol", ",", "loss", ",", "gradJ"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"xSol", "=", 
        RowBox[{"NDSolveValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
             RowBox[{"\[Theta]", " ", 
              RowBox[{"x", "[", "t", "]"}]}]}], ",", 
            RowBox[{
             RowBox[{"x", "[", "0", "]"}], "==", "x0"}]}], "}"}], ",", "x", 
          ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "T"}], "}"}], ",", 
          RowBox[{"AccuracyGoal", "->", "1"}], ",", 
          RowBox[{"PrecisionGoal", "->", "4"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"\[Lambda]Sol", "=", 
        RowBox[{"NDSolveValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"\[Lambda]", "'"}], "[", "t", "]"}], "==", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "\[Theta]"}], " ", 
               RowBox[{"\[Lambda]", "[", "t", "]"}]}], "+", 
              RowBox[{"2", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"xSol", "[", "t", "]"}], "-", 
                 RowBox[{"xStar", "[", "t", "]"}]}], ")"}]}]}]}], ",", 
            RowBox[{
             RowBox[{"\[Lambda]", "[", "T", "]"}], "==", "0"}]}], "}"}], ",", 
          "\[Lambda]", ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "T", ",", "0"}], "}"}], ",", 
          RowBox[{"AccuracyGoal", "->", "1"}], ",", 
          RowBox[{"PrecisionGoal", "->", "4"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"gradJ", "=", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Lambda]Sol", "[", "t", "]"}], " ", "*", 
           RowBox[{"xSol", "[", "t", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "T"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"loss", "=", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"xSol", "[", "t", "]"}], "-", 
             RowBox[{"xStar", "[", "t", "]"}]}], ")"}], "^", "2"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "T"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"loss", ",", "gradJ"}], "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Initial", " ", 
    RowBox[{"loss", "/", "grad"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"loss", ",", "grad"}], "}"}], "=", 
    RowBox[{"computeLossAndGrad", "[", "\[Theta]", "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Training", " ", "loop", " ", "with", " ", "adaptive", " ", "step", " ", 
    "size"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AbsoluteTiming", "[", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Eta]", "=", "\[Eta]max"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"loss", ",", "grad"}], "}"}], "=", 
       RowBox[{"computeLossAndGrad", "[", "\[Theta]", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Backtracking", " ", "line", " ", "search"}], "*)"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{"True", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\[Theta]trial", "=", 
          RowBox[{"\[Theta]", "+", 
           RowBox[{"\[Eta]", " ", "grad"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"losstrial", ",", "grad"}], "}"}], "=", 
          RowBox[{"computeLossAndGrad", "[", "\[Theta]trial", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"losstrial", "<=", 
            RowBox[{"loss", "-", 
             RowBox[{"c", " ", "\[Eta]", " ", 
              RowBox[{"grad", "^", "2"}]}]}]}], ",", 
           RowBox[{"Break", "[", "]"}], ",", 
           RowBox[{
            RowBox[{"\[Eta]", "=", 
             RowBox[{"\[Beta]", " ", "\[Eta]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"\[Eta]", "<", 
               RowBox[{"10", "^", 
                RowBox[{"-", "6"}]}]}], ",", 
              RowBox[{"Break", "[", "]"}]}], "]"}]}]}], "]"}]}]}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"\[Theta]", "=", 
       RowBox[{"\[Theta]", "+", 
        RowBox[{"\[Eta]", " ", "grad"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"\[Theta]Hist", ",", "\[Theta]"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"lossHist", ",", "loss"}], "]"}], ";"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "nIter"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
   "]"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Final", " ", "learned", " ", "x", 
    RowBox[{"(", "t", ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"xLearned", "[", "t_", "]"}], "=", 
    RowBox[{
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"\[Theta]", " ", 
           RowBox[{"x", "[", "t", "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"x", "[", "0", "]"}], "==", "x0"}]}], "}"}], ",", "x", ",", 
       
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "T"}], "}"}]}], "]"}], "[", "t", "]"}]}], 
   ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Final", " ", "learned", " ", "x", 
    RowBox[{"(", "t", ")"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"xLearned", "[", "t_", "]"}], "=", 
    RowBox[{
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"\[Theta]", " ", 
           RowBox[{"x", "[", "t", "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"x", "[", "0", "]"}], "==", "x0"}]}], "}"}], ",", "x", ",", 
       
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "T"}], "}"}]}], "]"}], "[", "t", "]"}]}], 
   ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Plot", " ", "learned", " ", "vs", " ", "target", " ", "trajectory"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plt1", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"xLearned", "[", "t", "]"}], ",", 
        RowBox[{"xStar", "[", "t", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "T"}], "}"}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Learned x(t)\>\"", ",", "\"\<Target x*(t)\>\""}], 
        "}"}]}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", "Dashed"}], "}"}]}], ",", 
      RowBox[{"PlotRange", "->", "Full"}], ",", 
      RowBox[{"PlotLabel", "->", "\"\<Trajectory Fit\>\""}]}], "]"}]}], ";"}],
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Plot", " ", "loss", " ", "over", " ", "iterations"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"plt2", "=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{"lossHist", ",", 
      RowBox[{"PlotLabel", "->", "\"\<Loss J(\[Theta]) over iterations\>\""}],
       ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Iteration\>\"", ",", "\"\<Loss\>\""}], "}"}]}], ",", 
      RowBox[{"PlotMarkers", "->", "Automatic"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Plot", " ", "\[Theta]", " ", "over", " ", "iterations"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"plt3", "=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{"\[Theta]Hist", ",", 
      RowBox[{"PlotLabel", "->", "\"\<\[Theta] over iterations\>\""}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Iteration\>\"", ",", "\"\<\[Theta]\>\""}], "}"}]}], ",", 
      
      RowBox[{"PlotMarkers", "->", "Automatic"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Show", " ", "all", " ", "plots"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"GraphicsGrid", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "plt1", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"plt2", ",", "plt3"}], "}"}]}], "}"}], "]"}], "\n", 
  "\n"}], "\[IndentingNewLine]"}], "Input",
