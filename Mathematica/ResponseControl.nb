Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "rate", " ", "constants"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"k0", "=", "1"}], ";", 
    RowBox[{"k1", "=", "1"}], ";", 
    RowBox[{"k2", "=", "1"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "ODE", " ", "system"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"odes", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"AA", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", 
          RowBox[{
           RowBox[{"AA", "[", "t", "]"}], "^", "2"}], " ", "k2"}], "-", 
         RowBox[{
          RowBox[{"AA", "[", "t", "]"}], " ", "k6"}], "+", 
         RowBox[{
          RowBox[{"DD", "[", "t", "]"}], " ", "k7"}], "+", 
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"EE", "[", "t", "]"}], "^", "2"}], " ", "k3"}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"BB", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"AA", "[", "t", "]"}]}], " ", 
          RowBox[{"BB", "[", "t", "]"}], " ", "k5"}], "+", 
         RowBox[{
          RowBox[{"AA", "[", "t", "]"}], " ", "k4"}], "-", 
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"BB", "[", "t", "]"}], "^", "2"}], " ", "k0"}], "+", 
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"CC", "[", "t", "]"}], "^", "2"}], " ", "k1"}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"CC", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"BB", "[", "t", "]"}], "^", "2"}], " ", "k0"}], "-", 
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"CC", "[", "t", "]"}], "^", "2"}], " ", "k1"}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"DD", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"AA", "[", "t", "]"}], " ", "k6"}], "-", 
         RowBox[{
          RowBox[{"DD", "[", "t", "]"}], " ", "k7"}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"EE", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"AA", "[", "t", "]"}], "^", "2"}], " ", "k2"}], "-", 
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"EE", "[", "t", "]"}], "^", "2"}], " ", "k3"}]}]}]}], 
      "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Initial", " ", "conditions"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"init", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"AA", "[", "0", "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"BB", "[", "0", "]"}], "==", "5"}], ",", 
       RowBox[{
        RowBox[{"CC", "[", "0", "]"}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"DD", "[", "0", "]"}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"EE", "[", "0", "]"}], "==", "0"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Integrate", " ", "the", " ", "system"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{"odes", ",", "init"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"AA", ",", "BB", ",", "CC", ",", "DD", ",", "EE"}], "}"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "50"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "dynamics"}], "*)"}], "\n", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"AA", "[", "t", "]"}], ",", 
         RowBox[{"BB", "[", "t", "]"}], ",", 
         RowBox[{"CC", "[", "t", "]"}], ",", 
         RowBox[{"DD", "[", "t", "]"}], ",", 
