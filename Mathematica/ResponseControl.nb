Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"kValsList", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"exprsList", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"countList", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"QmatAdj", "=", 
   RowBox[{"Adjugate", "[", "Qmat", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"kValsT", "=", 
      RowBox[{"RandomVariate", "[", 
       RowBox[{
        RowBox[{"LogNormalDistribution", "[", 
         RowBox[{"\[Mu]", ",", "\[Sigma]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"kValsT", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"\[Mu]", ",", "100"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", ">", "j"}], ",", 
         RowBox[{
          RowBox[{"kValsT", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
          RowBox[{"kValsT", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "i"}], "]"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "n"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "n"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"exprs", "=", 
      RowBox[{
       RowBox[{"QmatAdj", "[", 
        RowBox[{"[", 
         RowBox[{";;", ",", "mInd"}], "]"}], "]"}], "/.", " ", 
       RowBox[{"Thread", "[", 
        RowBox[{"kkSyms", "->", 
         SuperscriptBox[
          RowBox[{"Flatten", "[", "kValsT", "]"}], 
          RowBox[{"-", "1"}]]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"kValsList", ",", "kValsT"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"exprsList", ",", "exprs"}], "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"results", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"signCombo", ",", "\[IndentingNewLine]", 
          RowBox[{"SemialgebraicComponentInstances", "[", 
           RowBox[{
            RowBox[{"And", "@@", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"DeepRationalize", "[", 
                    RowBox[{"exprs", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], "*", 
                   RowBox[{"signCombo", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ">", "0"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ",", 
               RowBox[{"Thread", "[", 
                RowBox[{"vars", ">", "0"}], "]"}]}], "]"}]}], ",", "vars"}], 
           "]"}]}], "}"}], "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"signCombo", ",", "signCombos"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"count", " ", "=", " ", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{
            RowBox[{"results", "[", 
             RowBox[{"[", "r", "]"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], ">", "0"}], ",", 
         RowBox[{"count", "+=", "1"}]}], "]"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "1", ",", 
         RowBox[{"Length", "[", "results", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"countList", ",", "count"}], "]"}], ";"}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"nxx", ",", "1", ",", "5000"}], "}"}]}], "]"}], "//", 
  "AbsoluteTiming"}]}], "Input",
