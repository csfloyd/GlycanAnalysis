Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Define", " ", "rate", " ", "constants"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"k1", "=", "1"}], ";", 
   RowBox[{"k2", "=", "1"}], ";", 
   RowBox[{"k3", "=", "1"}], ";", 
   RowBox[{"k4", "=", "1"}], ";", 
   RowBox[{"k5", "=", "1"}], ";", 
   RowBox[{"k6", "=", "1"}], ";", 
   RowBox[{"k7", "=", "1"}], ";"}], "\n", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Define", " ", "ODE", " ", "system", " ", "using", " ", "double"}], "-", 
    RowBox[{"letter", " ", "species"}]}], "*)"}], 
  RowBox[{
   RowBox[{"odes", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"AA", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], " ", "k1", " ", 
         RowBox[{
          RowBox[{"AA", "[", "t", "]"}], "^", "2"}]}], "+", 
        RowBox[{"2", " ", "k2", " ", 
         RowBox[{"BB", "[", "t", "]"}]}], "+", 
        RowBox[{"k4", " ", 
         RowBox[{"CC", "[", "t", "]"}]}], "-", 
        RowBox[{"k5", " ", 
         RowBox[{"AA", "[", "t", "]"}]}], "+", 
        RowBox[{"k6", " ", 
         RowBox[{"DD", "[", "t", "]"}]}]}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"BB", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"k1", " ", 
         RowBox[{
          RowBox[{"AA", "[", "t", "]"}], "^", "2"}]}], "-", 
        RowBox[{"k2", " ", 
         RowBox[{"BB", "[", "t", "]"}]}], "-", 
        RowBox[{"k3", " ", 
         RowBox[{"BB", "[", "t", "]"}]}]}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"CC", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"k3", " ", 
         RowBox[{"BB", "[", "t", "]"}]}], "-", 
        RowBox[{"k4", " ", 
         RowBox[{"CC", "[", "t", "]"}]}], "+", 
        RowBox[{"k5", " ", 
         RowBox[{"AA", "[", "t", "]"}]}]}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"DD", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"k3", " ", 
         RowBox[{"BB", "[", "t", "]"}]}], "-", 
        RowBox[{"k6", " ", 
         RowBox[{"DD", "[", "t", "]"}]}]}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"EE", "'"}], "[", "t", "]"}], "==", 
       RowBox[{"k6", " ", 
        RowBox[{"DD", "[", "t", "]"}]}]}]}], 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"-", "k7"}], " ", 
       RowBox[{"EE", "[", "t", "]"}]}], "*)"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Initial", " ", "concentrations"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"init", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"AA", "[", "0", "]"}], "==", "1"}], ",", 
      RowBox[{
       RowBox[{"BB", "[", "0", "]"}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{"CC", "[", "0", "]"}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{"DD", "[", "0", "]"}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{"EE", "[", "0", "]"}], "==", "1"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Solve", " ", "the", " ", "system"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sol", "=", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{"odes", ",", "init"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"AA", ",", "BB", ",", "CC", ",", "DD", ",", "EE"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "50"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Plot", " ", "concentrations", " ", "over", " ", "time"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"AA", "[", "t", "]"}], ",", 
        RowBox[{"BB", "[", "t", "]"}], ",", 
        RowBox[{"CC", "[", "t", "]"}], ",", 
        RowBox[{"DD", "[", "t", "]"}], ",", 
        RowBox[{"EE", "[", "t", "]"}]}], "}"}], "/.", " ", "sol"}], "]"}], 
    ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "50"}], "}"}], ",", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"{", 
      RowBox[{
      "\"\<AA\>\"", ",", "\"\<BB\>\"", ",", "\"\<CC\>\"", ",", "\"\<DD\>\"", 
       ",", "\"\<EE\>\""}], "}"}]}], ",", 
    RowBox[{"PlotRange", "->", "All"}], ",", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<t\>\"", ",", "\"\<Concentration\>\""}], "}"}]}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]"}], "Input",
