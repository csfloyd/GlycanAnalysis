        RowBox[{"i", ">", "j"}], ",", 
        RowBox[{
         RowBox[{"KK", "[", 
          RowBox[{"i", ",", "j"}], "]"}], "->", 
         RowBox[{"KK", "[", 
          RowBox[{"j", ",", "i"}], "]"}]}], ",", "Nothing"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Qmat", "=", 
