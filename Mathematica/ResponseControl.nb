       RowBox[{"kValsT", "+", "1"}], "//", "Round"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", ">", "j"}], ",", 
         RowBox[{
          RowBox[{"kValsT", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
          RowBox[{"kValsT", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "i"}], "]"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "n"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "n"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"exprs", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"QmatAdj", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "mInd"}], "]"}], "]"}], "/.", " ", 
        RowBox[{"Thread", "[", 
         RowBox[{"kkSyms", "->", 
          SuperscriptBox[
           RowBox[{"Flatten", "[", "kValsT", "]"}], 
